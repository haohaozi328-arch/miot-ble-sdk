CONFIG_IDF_TARGET="esp32c3"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# IDF v6.0 的 mbedTLS 4.x 默认只暴露 PSA，legacy CCM/MD/ECP 要显式打开。
# port/esp32/miot_port_esp32.c 走的是 legacy 接口（头在 mbedtls/private/ 下）。
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_BIGNUM_C=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_MD_C=y
CONFIG_MBEDTLS_SHA256_C=y

# ★spec 解析跑在 NimBLE host 任务里：miot_spec_packet_t(~600B) + set_reply 结果
# 数组(~600B) 再叠加日志缓冲，默认 4096 会栈溢出崩溃（实测 23:52 Guru Meditation）。
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# ★app_main（主任务）默认栈 3584 不够：登录完成后处理 GET/推属性时，
# miot_spec_packet_t(~600B) + spec_reply 的 out(306B)/hex(124B) + 日志
# vsnprintf 一起压栈，实测 panic「Stack protection fault」→ App 报
# 「蓝牙连接失败」。这里给到 8192。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 默认档案：2 = 米家体脂秤 S400（0x30D9）。串口 `dev N` 可随时切换。
CONFIG_MIOT_DEV_DEFAULT_INDEX=2

# ★2026-11-13 Mesh 承载层：云端档案是「蓝牙 Mesh」设备，必须挂 Mesh 协议栈。
# PB-ADV（未配网 beacon）+ PB-GATT（0x1827）开，Proxy 开（配网后可能用到），
# Relay/Friend/LPN 关（体脂秤无中继需求，省 RAM）。
CONFIG_BT_NIMBLE_MESH=y
CONFIG_BT_NIMBLE_MESH_PROV=y
CONFIG_BT_NIMBLE_MESH_PB_ADV=y
CONFIG_BT_NIMBLE_MESH_PB_GATT=y
CONFIG_BT_NIMBLE_MESH_GATT_PROXY=y
CONFIG_BT_NIMBLE_MESH_RELAY=n
CONFIG_BT_NIMBLE_MESH_FRIEND=n
CONFIG_BT_NIMBLE_MESH_LOW_POWER=n
