CONFIG_IDF_TARGET="esp32c3"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# IDF v6.0 的 mbedTLS 4.x 默认只暴露 PSA，legacy CCM/MD/ECP 要显式打开。
# port/esp32/miot_port_esp32.c 走的是 legacy 接口（头在 mbedtls/private/ 下）。
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_BIGNUM_C=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_MD_C=y
CONFIG_MBEDTLS_SHA256_C=y

# main 任务栈：初值推送(8属性)+spec加密发送在 main 上下文执行，
# 默认 3584B 会 Stack protection fault（ddla 实测 panic 0x4038afee）。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ★spec 解析链路整个跑在 NimBLE host 任务（nimble_host）里，默认 4096 不够：
#   App 发版本交换 F0 → miot_device_dispatch_plain 在栈上开 miot_spec_packet_t
#   (~1.7KB) + handle_get 的 vals[]，直接 Stack protection fault panic，
#   task "nimble_host", SP 越过栈下界。磁吸灯 carlight 实测 0x4038b0ca。
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
