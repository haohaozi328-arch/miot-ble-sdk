    { "cmd": "0x30", "name": "TIME",      "zh": "时间显示" },
    { "cmd": "0x36", "name": "SLEEP",     "zh": "睡眠定时" },
    { "cmd": "0x3A", "name": "CH_DISP",   "zh": "频道显示" },
    { "cmd": "0x3B", "name": "JUMP",      "zh": "频道跳回" },

    { "cmd": "0x40", "name": "VIDEO1",    "zh": "输入 Video 1" },
    { "cmd": "0x41", "name": "VIDEO2",    "zh": "输入 Video 2" },
    { "cmd": "0x42", "name": "VIDEO3",    "zh": "输入 Video 3" },

    { "cmd": "0x58", "name": "PIP_CH+",   "zh": "画中画频道 +" },
    { "cmd": "0x59", "name": "PIP_CH-",   "zh": "画中画频道 -" },
    { "cmd": "0x5B", "name": "PIP_ON",    "zh": "画中画开关" },
    { "cmd": "0x5C", "name": "FREEZE",    "zh": "画面冻结" },

    { "cmd": "0x60", "name": "GUIDE",     "zh": "节目指南" },
    { "cmd": "0x61", "name": "VIDEO_SET", "zh": "图像设置" },
    { "cmd": "0x62", "name": "AUDIO_SET", "zh": "声音设置" },
    { "cmd": "0x63", "name": "EXIT_SET",  "zh": "退出设置" },
    { "cmd": "0x6B", "name": "AUTO_PROG", "zh": "自动搜台" },

    { "cmd": "0x70", "name": "TREBLE+",   "zh": "高音 +" },
