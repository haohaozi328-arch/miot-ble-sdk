  "建议暗号": [
    { "用途": "开",  "cmd": "0x15", "理由": "POWER，米家虚拟遥控页第一排就有，好按" },
    { "用途": "关",  "cmd": "0x2F", "理由": "PWR_OFF 只关不开，绝对指令，不会漂移" },
    { "用途": "场景A", "cmd": "0x40", "理由": "VIDEO1，家里没索尼电视时没人用这个键" },
    { "用途": "场景B", "cmd": "0x41", "理由": "VIDEO2" },
    { "用途": "场景C", "cmd": "0x42", "理由": "VIDEO3" }
  ]
}
