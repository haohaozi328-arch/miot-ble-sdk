{
  "_说明": "索尼 SIRC 电视码表（device code = 0x01）。数据来源：SIRCS 官方命令表 + Flipper-IRDB Sony Bravia，两组独立来源一致。载波 40kHz，帧头 2.4ms/0.6ms，位宽 mark 0.6ms=0 / 1.2ms=1，LSB first，12bit = 7bit cmd + 5bit dev。",
  "protocol": "SIRC12",
  "device": "0x01",
  "carrier_khz": 40,
  "keys": [
    { "cmd": "0x00", "name": "1",         "zh": "数字 1" },
    { "cmd": "0x01", "name": "2",         "zh": "数字 2" },
    { "cmd": "0x02", "name": "3",         "zh": "数字 3" },
    { "cmd": "0x03", "name": "4",         "zh": "数字 4" },
    { "cmd": "0x04", "name": "5",         "zh": "数字 5" },
    { "cmd": "0x05", "name": "6",         "zh": "数字 6" },
    { "cmd": "0x06", "name": "7",         "zh": "数字 7" },
    { "cmd": "0x07", "name": "8",         "zh": "数字 8" },
    { "cmd": "0x08", "name": "9",         "zh": "数字 9" },
    { "cmd": "0x09", "name": "0",         "zh": "数字 0" },
    { "cmd": "0x0B", "name": "ENTER",     "zh": "确认/输入" },

    { "cmd": "0x10", "name": "CH+",       "zh": "频道 +" },
    { "cmd": "0x11", "name": "CH-",       "zh": "频道 -" },
    { "cmd": "0x12", "name": "VOL+",      "zh": "音量 +",   "note": "已实测" },
    { "cmd": "0x13", "name": "VOL-",      "zh": "音量 -",   "note": "待实测，建议作「关」指令" },
    { "cmd": "0x14", "name": "MUTE",      "zh": "静音" },
    { "cmd": "0x15", "name": "POWER",     "zh": "电源/开关", "note": "已实测，建议作「开」指令" },
    { "cmd": "0x16", "name": "RESET",     "zh": "电视复位" },
    { "cmd": "0x17", "name": "AUDIO",     "zh": "音效模式（单声道/双语/立体声）" },
    { "cmd": "0x18", "name": "PIC+",      "zh": "图像 +" },
    { "cmd": "0x19", "name": "PIC-",      "zh": "图像 -" },
    { "cmd": "0x1E", "name": "BRIGHT+",   "zh": "亮度 +" },
    { "cmd": "0x1F", "name": "BRIGHT-",   "zh": "亮度 -" },

    { "cmd": "0x25", "name": "INPUT",     "zh": "切换输入源" },
